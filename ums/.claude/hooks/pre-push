#!/bin/sh
# UMS pre-push guard (Publication Contract)
#
# This is the actual enforcement boundary for the Publication Contract's
# two-tier push policy (see UMS_MEMORY_BANK_CONTRACT.md, "Publication
# Contract"). Unlike a PreToolUse hook working from a shell command string,
# git invokes this hook with fully-resolved refs on stdin — every CLI
# spelling trick (HEAD, --git-dir, bash -c, env prefixes, operator
# adjacency, config overrides) collapses to the same four fields below, so
# there is no shell syntax left to bypass.
#
# Scope: refs/heads/* (branches) only. The two-tier policy is branch-scoped;
# tag pushes and anything else are out of scope and always pass through
# untouched (a tag delete or a tag force-move is not a "branch push").
#
# Installed per clone by ums/.claude/hooks/install-git-hooks.ps1, resolved
# via `git rev-parse --git-path hooks/pre-push` so this lands where git
# ACTUALLY looks even for a linked worktree or a core.hooksPath override
# (git hooks live outside version control, so this guarantee only exists
# once that script has been run against a given working copy).
#
# THE HUMAN ESCAPE: UMS_ALLOW_SHARED_PUSH=1 in the environment lifts the
# shared-branch rule (and only that rule — deletion and force push stay
# forbidden). It exists because a git hook cannot tell a human from an agent:
# the whole layer asks the USER to publish `develop` themselves, so without an
# escape the hook would block the very remedy it points at, and `--no-verify`
# — which disables every hook, not just this rule — would become the only way
# out. The rejection message below names the escape, so whoever hits the wall
# learns the way through it at that moment. An AGENT MUST NEVER SET IT: that
# is contract text (Publication Contract), the same trust model as every other
# rule of this layer, not something this hook can enforce.
#
# Two known, accepted bypasses — both require deliberate, visible intent,
# unlike every CLI-spelling trick this hook exists to close:
#   - `git push --no-verify` skips this hook entirely.
#   - `git -c core.hooksPath=<other>` (or a persistent core.hooksPath
#     override) points git at a different hooks directory altogether.
#
# Invocation: $1 = remote name, $2 = remote URL. Stdin lines:
#   <local ref> SP <local sha1> SP <remote ref> SP <remote sha1> LF

remote_name="$1"
zero='0000000000000000000000000000000000000000'
reject=0

branch_name() {
    # Prefix stripped case-insensitively, so the name printed in the message
    # is right for any spelling the scope gate below let through.
    printf '%s' "$1" | sed 's#^[Rr][Ee][Ff][Ss]/[Hh][Ee][Aa][Dd][Ss]/##'
}

to_lower() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_ref" ] && continue

    # Everything below matches against the LOWER-CASED ref. The scope gate
    # and the protected-name check are two halves of one rule, so they must
    # agree about case: a case-sensitive gate let `refs/HEADS/develop` skip
    # the guard entirely, even though the check below would have caught it.
    # (guard-git-push.mjs is case-insensitive here too - the layers must not
    # disagree either.)
    remote_ref_lc=$(to_lower "$remote_ref")

    # Out of scope: only refs/heads/* (branches) are policed here. Tags and
    # anything else pass through untouched.
    case "$remote_ref_lc" in
        refs/heads/*) ;;
        *) continue ;;
    esac

    case "$remote_ref_lc" in
        refs/heads/develop|refs/heads/main|refs/heads/master|refs/heads/release/*)
            b=$(branch_name "$remote_ref")
            if [ "$UMS_ALLOW_SHARED_PUSH" = "1" ]; then
                # Deliberate human publication — announced, not silent, so an
                # escape left set in a shell stays visible. NOT a `continue`:
                # the deletion and non-fast-forward rules below still apply to
                # this ref, the escape lifts the shared-branch rule only.
                echo "UMS: UMS_ALLOW_SHARED_PUSH=1 — push do sdílené větve '$b' povolen (vědomá výjimka člověka)." >&2
            else
                echo "UMS: '$b' je sdílená větev — agent do ní nepushuje (Publication Contract)." >&2
                echo "     Připrav příkaz a nech ho uživateli:" >&2
                echo "     \`! UMS_ALLOW_SHARED_PUSH=1 git push $remote_name $b\`" >&2
                echo "     UMS_ALLOW_SHARED_PUSH=1 je vědomá výjimka pro člověka; agent ji nikdy nenastavuje." >&2
                echo "     (Výjimka platí jen na sdílené větve — mazání a force push zůstávají zakázané.)" >&2
                reject=1
                continue
            fi
            ;;
    esac

    if [ "$local_sha" = "$zero" ]; then
        b=$(branch_name "$remote_ref")
        echo "UMS: mazání větve '$b' přes push není povolené (Publication Contract)." >&2
        reject=1
        continue
    fi

    if [ "$remote_sha" != "$zero" ]; then
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            b=$(branch_name "$remote_ref")
            echo "UMS: push do '$b' není fast-forward (vynucený/force push) — zakázáno" >&2
            echo "     (Publication Contract). Historii nikdy nepřepisuj tiše, řeš to s uživatelem." >&2
            reject=1
            continue
        fi
    fi
done

exit $reject
